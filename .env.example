# Copy to .env.local and fill in. All are read at BUILD time, so set them wherever
# you run `npm run build` for production as well as locally.

# Canonical URLs, Open Graph and the sitemap are built from this.
NEXT_PUBLIC_SITE_URL=https://sennin.app

# Shown on the privacy policy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=kupdevs@gmail.com

# The Cloudflare Worker in worker/. Leave unset and the visitor badge is not rendered
# at all, rather than showing a number the site has not actually counted.
NEXT_PUBLIC_VISITOR_COUNTER_URL=

# Optional: the ad network's script. Unset means ad slots stay empty.
NEXT_PUBLIC_AD_SCRIPT_SRC=
